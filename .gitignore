# Colab R2 exchange: signed URLs are capabilities, never committed
production/**/exchange.json
# Imported Colab media lives in R2 (exports/audiovisual-archive/); only its hash manifest is committed
production/audiovisual/*/narration/*/
production/audiovisual/*/stills/*/
production/audiovisual/*/retouch/*/
production/audiovisual/*/edit/*/
production/audiovisual/*/touchup/*/
production/audiovisual/*/music/*/
production/audiovisual/*/film/*/*.wav
production/audiovisual/*/film/*/*.mp4
production/audiovisual/*/film/*/stills/
production/audiovisual/*/takes/audio/
production/audiovisual/*/.record.lock
# Film bundles: the MP4 copy stays local (film.json and film.vtt are tracked)
production/**/bundle/film.mp4
