  "scheduled_commands": [
    {
      "name": "maintenance",
      "cron_UTC": "* * * * *",
      "command": "python manage.py run_maintenance --max-seconds 45 --batch-size 25",
      "lease_seconds": 120,
      "batch_size": 25,
      "max_runtime_seconds": 45,
      "includes": [
        "due outbox",
        "scheduled publishing",
        "bounded payment reconciliation",
        "expired session/token cleanup"
      ],
      "proposed_management_command": true
    },
    {
      "name": "independent_export",
      "cron_UTC": "0 3 * * *",
      "command": "python manage.py export_database --encrypted --manifest",
      "direct_connection": true,
      "separate_credential": true,
      "proposed_management_command": true
    }
  ],
  "jobs": {
    "delivery_semantics": "at-least-once external effects with durable local deduplication",
    "claim_query": "SELECT FOR UPDATE SKIP LOCKED then lease and commit before provider call",
    "retry_delays_seconds": [
      30,
      120,
      600,
      1800,
      7200,
      21600
    ],
    "jitter": "uniform 0.8 to 1.2 multiplier",
    "max_concurrent_external_calls": 2,
    "honor_retry_after": true,
    "financial_unknown_outcome": "reconcile before retry; never create a replacement charge blindly",
    "max_attempts": 7,
    "attempt_definition": "initial attempt plus six scheduled retries; seventh failure is terminal until operator retry"
  },
  "backups": {
    "neon_restore_history_days": 7,
    "independent_export_interval_hours": 24,
    "daily_export_retention_days_proposed": 30,
    "monthly_snapshot_count_proposed": 12,
    "retention_approval_status": "owner/privacy/finance schedule required before launch",
    "restore_drill_interval_days": 90,
    "regional_restore_target_hours_untested": 4,
    "export_RPO_hours_untested": 24,
    "zonal_recovery_design_allowance_minutes_untested": 10,
    "node_recovery_target_minutes_untested": 5
  },
  "alarms": [
    {
      "signal": "private_api_5xx",
      "threshold": "more than 1 percent over 5 minutes with at least 50 requests",
      "action": "operator alert and inspect dependency health"
    },
    {
      "signal": "synthetic_preview_failure",
      "threshold": "3 consecutive one-minute probes",
      "action": "operator alert; separate edge versus origin"
    },
    {
      "signal": "payment_mismatch",
      "threshold": "any verified amount/currency/ownership mismatch",
      "action": "immediate operator review; do not grant access"
    },
    {
      "signal": "captured_payment_without_grant",
      "threshold": "older than 2 minutes",
      "action": "immediate reconciliation alert"
    },
    {
      "signal": "outbox_oldest_due_age",
      "threshold": "more than 5 minutes",
      "action": "inspect scheduler and provider failures"
    },
    {
      "signal": "export_age",
      "threshold": "more than 26 hours",
      "action": "backup alert and bounded retry"
    },
    {
      "signal": "database_at_max_CU",
      "threshold": "more than 15 minutes with p95 query latency above qualified budget",
      "action": "inspect plans and hot working set; cost review before raising cap"
    },
    {
      "signal": "db_connection_wait",
      "threshold": "p95 above 250 milliseconds for 5 minutes",
      "action": "inspect concurrency and slow queries; do not increase pools blindly"
    },
    {
      "signal": "monthly_cost_forecast",
      "threshold": "more than 20 percent above approved scenario",
      "action": "owner cost alert; no automatic outage-inducing shutdown"
    }
  ],
