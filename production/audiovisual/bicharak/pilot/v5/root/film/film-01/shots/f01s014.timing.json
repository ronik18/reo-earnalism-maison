  "timing": [
    {
      "end": 2.337,
      "start": 0.85,
      "text": "মনে হইতে লাগিল,"
    },
    {
      "end": 7.93,
      "start": 2.787,
      "text": "পৃথিবীতে ঘরে ঘরে সমস্ত কুলকন্যারা এখন গভীর সুষুপ্তিতে নিমগ্ন।"
    },
    {
      "end": 18.827,
      "start": 8.93,
      "text": "সেই আপনার ঘরে আপনার শয্যাটির মধ্যে নিস্তব্ধ রাত্রের নিশ্চিন্ত নিদ্রা যে কত সুখের তাহা ইতিপূর্ব্বে কেন সে বুঝিতে পারে নাই!"
    },
    {
      "end": 23.649,
      "start": 20.427,
      "text": "ঘরের মেয়েরা কাল সকালবেলায় ঘরের মধ্যে জাগিয়া উঠিবে,"
    },
    {
      "end": 27.021,
      "start": 24.199,
      "text": "নিঃসঙ্কোচে নিত্যকর্ম্মের মধ্যে প্রবৃত্ত হইবে,"
    },
    {
      "end": 32.686,
      "start": 27.615,
      "text": "আর গৃহচ্যুতা হেমশশির এই নিদ্রাহীন রাত্রি কোন্‌খানে গিয়া প্রভাত হইবে,"
    },
    {
      "end": 48.508,
      "start": 33.336,
      "text": "এবং সেই নিরানন্দ প্রভাতে তাহাদের সেই গলির ধারের ছোটখাট ঘরকন্নাটির উপর যখন সকালবেলাকার চিরপরিচিত শান্তিময় হাস্যপূর্ণ রৌদ্রটি আসিয়া পতিত হইবে তখন সেখানে সহসা কি লজ্জা প্রকাশিত হইয়া পড়িবে,"
    },
    {
      "end": 52.592,
      "start": 49.209,
      "text": "কি লাঞ্ছনা কি হাহাকার জাগ্রত হইয়া উঠিবে!"
    }
  ],
